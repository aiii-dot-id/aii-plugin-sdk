{
  "name": "an inbound Twilio webhook becomes an arrival and a TwiML reply",
  "operation": "sms.inbound",
  "arguments": {
    "method": "POST",
    "path": "sms",
    "query": "",
    "headers": {
      "Content-Type": "application/x-www-form-urlencoded"
    },
    "body": "Body=hi+there&From=%2B15550001&MessageSid=SM1"
  },
  "expect": {
    "status": "succeeded",
    "result_contains": "\"from\":\"+15550001\""
  }
}
