{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
    },
    "receive": {
      "type": "string",
      "enum": [
        "poll",
        "webhook"
      ]
    },
    "budget_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60,
      "description": "how long receive may block; 0 = the host's default of ten seconds"
    }
  },
  "required": [
    "channel"
  ],
  "additionalProperties": false
}
