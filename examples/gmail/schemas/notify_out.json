{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "arrivals": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "from"
        ],
        "additionalProperties": false
      }
    },
    "response": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
