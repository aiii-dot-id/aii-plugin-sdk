{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "the message's id, as gmail.search gives it"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "description": "where in the text to read from: the next_offset an earlier answer gave"
    }
  },
  "required": [
    "message_id"
  ],
  "additionalProperties": false
}
